# All settings are optional. No API key is required by the bundled public providers.
HOST=127.0.0.1
PORT=8787
MARKET_CACHE_TTL_SECONDS=300
MARKET_STALE_TTL_SECONDS=86400
MARKET_REQUEST_TIMEOUT_MS=9000
MARKET_PROVIDER_CONCURRENCY=4

# 持久化存储（可选）。配置后目录/扫描/评分/行情缓存写入 libSQL：
#   远程 Turso：libsql://<db-name>-<org>.turso.io，配 TURSO_AUTH_TOKEN
#   本地文件：file:./chan.db（零依赖自托管，无需 token）
# 未配置时使用进程内存（重启即失）。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 定时流水线（Node 宿主内置 timer，配置 TURSO_DATABASE_URL 后自动启用）。
# CRON_TICK_SECONDS：每个 tick 的间隔秒数（最小 60）。
# CRON_CN_SYNC_DEADLINE_HOURS：CN 来源全部失败时，提交目录前等待外部 CN 同步的小时数（0=不等）。
CRON_TICK_SECONDS=60
CRON_SCAN_BATCH=8
CRON_CYCLE_HOUR_UTC=16
CRON_CN_SYNC_DEADLINE_HOURS=1
# 调试开关：CRON_IGNORE_GATE=1 解除每日时间门控，任意时间启动周期（验证用）。
# CRON_IGNORE_GATE=0

# 推送通知（全部可选，任一配置即生效；快照发布时推送当日信号摘要）。
#   Bark：完整地址含设备密钥，如 https://api.day.app/<key> 或自建服务
#   ntfy：主题地址，如 https://ntfy.sh/<topic>
#   webhook：任意接收 JSON {source,title,body} 的地址
NOTIFY_BARK_URL=
NOTIFY_NTFY_URL=
NOTIFY_WEBHOOK_URL=
