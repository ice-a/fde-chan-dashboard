{
  "name": "chan-resonance-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/node/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file-if-exists=.env server/node/index.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup-db.ts",
    "docker:up": "docker compose up --build"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "echarts": "^6.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.3"
  },
  "packageManager": "pnpm@9.15.4"
}
